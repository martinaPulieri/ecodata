# Local development only; Compose reads these values for its database.
POSTGRES_USER=ecodata
POSTGRES_PASSWORD=ecodata
POSTGRES_DB=ecodata
POSTGRES_PORT=5432
API_PORT=8000
UI_PORT=8501

# Host-run API and Alembic. Compose supplies its own URL using hostname db.
ECODATA_DATABASE_URL=postgresql+psycopg://ecodata:ecodata@localhost:5432/ecodata
ECODATA_DATABASE_CONNECT_TIMEOUT=3
ECODATA_API_URL=http://localhost:8000
