{
  "catalogue_version": "date-patterns-1.2",
  "provisional": true,
  "implementation_status": "lexical-dates-1.1",
  "calendar_validation": false,
  "value_conversion": false,
  "patterns": {
    "ymd-dash": {
      "kind": "single",
      "format": "YYYY-MM-DD",
      "order": "YMD",
      "widths": {
        "year": 4,
        "month": 2,
        "day": 2
      },
      "separator": "-",
      "example": "2020-03-15"
    },
    "dmy-slash": {
      "kind": "single",
      "format": "DD/MM/YYYY",
      "order": "DMY",
      "widths": {
        "year": 4,
        "month": 2,
        "day": 2
      },
      "separator": "/",
      "example": "03/04/2020"
    },
    "mdy-slash": {
      "kind": "single",
      "format": "MM/DD/YYYY",
      "order": "MDY",
      "widths": {
        "year": 4,
        "month": 2,
        "day": 2
      },
      "separator": "/",
      "example": "03/04/2020"
    },
    "dmy-dash": {
      "kind": "single",
      "format": "DD-MM-YYYY",
      "order": "DMY",
      "widths": {
        "year": 4,
        "month": 2,
        "day": 2
      },
      "separator": "-",
      "example": "03-04-2020"
    },
    "mdy-dash": {
      "kind": "single",
      "format": "MM-DD-YYYY",
      "order": "MDY",
      "widths": {
        "year": 4,
        "month": 2,
        "day": 2
      },
      "separator": "-",
      "example": "03-04-2020"
    },
    "year": {
      "kind": "partial",
      "format": "YYYY",
      "widths": {
        "year": 4
      },
      "example": "2020"
    },
    "year-month": {
      "kind": "partial",
      "format": "YYYY-MM",
      "widths": {
        "year": 4,
        "month": 2
      },
      "separator": "-",
      "example": "2020-03"
    },
    "timestamp-z": {
      "kind": "timestamp",
      "format": "YYYY-MM-DDTHH:mm:ssZ",
      "order": "YMD",
      "date_pattern": "ymd-dash",
      "timezone": "literal Z",
      "example": "2020-03-15T14:30:00Z"
    },
    "ymd-interval": {
      "kind": "interval",
      "format": "YYYY-MM-DD/YYYY-MM-DD",
      "endpoint_patterns": [
        "ymd-dash",
        "ymd-dash"
      ],
      "separator": "/",
      "example": "2020-03-15/2020-03-20"
    },
    "split-numeric": {
      "kind": "split",
      "format": "named day/month/year components",
      "widths": {
        "day": [
          1,
          2
        ],
        "month": [
          1,
          2
        ],
        "year": [
          4
        ]
      },
      "example": "year=2020; day=7; month=03"
    },
    "timestamp-no-zone": {
      "kind": "timestamp",
      "format": "YYYY-MM-DDTHH:mm:ss",
      "order": "YMD",
      "date_pattern": "ymd-dash",
      "timezone": "unspecified",
      "example": "2009-06-29T00:00:00"
    },
    "dmy-slash-yy": {
      "kind": "single",
      "format": "DD/MM/YY",
      "order": "DMY",
      "widths": {
        "year": 2,
        "month": 2,
        "day": 2
      },
      "separator": "/",
      "example": "17/05/11"
    },
    "mdy-slash-yy": {
      "kind": "single",
      "format": "MM/DD/YY",
      "order": "MDY",
      "widths": {
        "year": 2,
        "month": 2,
        "day": 2
      },
      "separator": "/",
      "example": "05/17/11"
    }
  },
  "excluded_initial_formats": [
    "natural language",
    "unlisted timestamp/timezone variants"
  ],
  "notes": "Extends 1.1 with exact DD/MM/YY and MM/DD/YY lexical patterns. Two-digit years remain unresolved text: no century pivot, expansion, calendar validation or value conversion. Executed by the existing lexical-dates-1.1 generic-width engine. Historical catalogues remain unchanged."
}
